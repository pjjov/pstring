    PSTRING_OK = 0,
    PSTRING_ENOENT = \-2,
    PSTRING_EINTR = \-4,
    PSTRING_EIO = \-5,
    PSTRING_ENOMEM = \-12,
    PSTRING_EEXIST = \-17,
    PSTRING_EINVAL = \-22,
    PSTRING_EDOM = \-33,
    PSTRING_ERANGE = \-34,
    PSTRING_ENOSYS = \-38,
    PSTRING_ENODATA = \-61,
    PSTRING_EENCODE = \-192,
    PSTRING_EDECODE = \-193,
    PSTRING_EOBJECT = \-194,
};\fR
.fi
.PP
.nf
