.TH "PATTERN MATCHING WITH PLUGGABLE ENGINES." "3" "" "pstring 1.5" "pstring manual"
.SH NAME
Pattern matching with pluggable engines. \- This module doesn't implement any pattern matching algorithm itself.
.SH SYNOPSIS
.nf
\fB#include <pattern.h>\fR
.fi
.PP
.nf
\fB#define PSTREXPR_CACHE_SIZE 32\fR
.fi
.PP
.nf
\fB#define PSTREXPR_NOSPAN ((size_t)\-1)\fR
.fi
.PP
.nf
\fBenum pstrexpr_flag {

    PSTREXPR_REGEX = 1,
};\fR
.fi
.PP
.nf
\fBenum pstrexpr_prop {

    PSTREXPR_UTF8 = 1,
};\fR
.fi
.PP
.nf
\fBtypedef struct pstrexpr_span {
    size_t start;
    size_t end;
} pstrexpr_span_t;\fR
.fi
.PP
.nf
\fBstruct pstrexpr_info {

    size_t groups;

    unsigned props;
};\fR
.fi
.PP
.nf
\fBtypedef int(pstriterp_fn)(const pstrarray_t *groups, size_t index, void *user);\fR
.fi
.PP
.nf
\fBstruct pstrexpr_vt {

    const char *name;


    unsigned flags;


    int escape;


    int (*compile)(
        void **prog,
        struct pstrexpr_info *info,
        const pstring_t *pattern,
        const pstring_t *flags,
        allocator_t *alloc,
        void *user
    );


    void (*destroy)(void *prog, allocator_t *alloc, void *user);


    int (*exec)(
        void *prog,
        const char *subject,
        size_t length,
        size_t start,
        pstrexpr_span_t *spans,
        size_t nspans,
        void *user
    );


    int (*group)(void *prog, const pstring_t *name, void *user);


    int (*quote)(pstring_t *out, const pstring_t *text, void *user);
};\fR
.fi
.PP
.nf
\fBint pstrexpr_register(
    const char *prefix, const struct pstrexpr_vt *vtable, void *user
);\fR
.fi
.PP
.nf
\fBint pstrexpr_alias(const char *alias, const char *prefix);\fR
.fi
.PP
.nf
\fBvoid pstrexpr_cache_clear(void);\fR
.fi
.PP
.nf
\fBPSTR_INLINE int pstrexpr_isset(const pstring_t *group);\fR
.fi
.PP
.nf
\fBint pstrmatch(
    const char *pattern, const pstring_t *src, pstrarray_t *captures
);\fR
.fi
.PP
.nf
\fBint pstrsplitp(
    const char *pattern,
    const pstring_t *src,
    pstrarray_t *parts,
    size_t maxSplit
);\fR
.fi
.PP
.nf
\fBint pstrreplp(
    const char *pattern, const char *repl, pstring_t *str, size_t max
);\fR
.fi
.PP
.nf
\fBint pstriterp(
    const char *pattern, const pstring_t *src, pstriterp_fn *iter, void *user
);\fR
.fi
.PP
.nf
\fBint pstrexpr_compile(
    pstrexpr_t **out, const char *pattern, allocator_t *alloc
);\fR
.fi
.PP
.nf
\fBvoid pstrexpr_free(pstrexpr_t *expr);\fR
.fi
.PP
.nf
\fBsize_t pstrexpr_groups(const pstrexpr_t *expr);\fR
.fi
.PP
.nf
\fBint pstrexpr_match(
    const pstrexpr_t *expr, const pstring_t *src, pstrarray_t *captures
);
int pstrexpr_split(
    const pstrexpr_t *expr,
    const pstring_t *src,
    pstrarray_t *parts,
    size_t maxSplit
);
int pstrexpr_repl(
    const pstrexpr_t *expr, const char *repl, pstring_t *str, size_t max
);
int pstrexpr_iter(
    const pstrexpr_t *expr, const pstring_t *src, pstriterp_fn *iter, void *user
);\fR
.fi
.PP
.nf
\fBint pstrexpr_escape(
    pstring_t *out, const char *prefix, const pstring_t *text
);\fR
.fi
.PP
.nf
\fBint pstrexpr_quote(
    pstring_t *out, const char *prefix, const pstring_t *text, const char *flags
);\fR
.fi
.SH DESCRIPTION
.PP
This module doesn't implement any pattern matching algorithm itself.
Instead, it provides a common interface on top of which existing libraries
(PCRE2, POSIX regex, Oniguruma, ...) are plugged in at runtime, using
thin adapters (see \fB<pstring/pattern/pcre2.h>\fR and friends). The library
never links against any of them: the application includes the adapter
it needs and registers it during initialization.
.PP
.RS 4
.nf
#include <pstring/pattern.h>
#include <pstring/pattern/pcre2.h>

pstrexpr_register_pcre2(NULL); // registers "pcre" (and "re")

pstrarray_t caps = { 0 };
if (pstrmatch("pcre/(\e\ew+)@(\e\ew+)/i", str, &caps) == PSTRING_TRUE)
    ...
pstrarray_free(&caps);
.fi
.RE
.SS PATTERN SYNTAX
.PP
Patterns are strings with the following layout, inspired by PCRE/PHP:
.PP
.RS 4
.nf
<prefix><delimiter><body><delimiter><flags>

"pcre/[a\-z]+\e\ed/im"     engine "pcre", body `[a\-z]+\ed`, flags "im"
"lua:%d+:"              engine "lua",  body `%d+`,      no flags
"re{a{2,3}}x"           brackets nest, so no escaping is needed
"/foo/i"                empty prefix, same as "re/foo/i"
.fi
.RE
.IP \(bu 2
\fBprefix\fR is the name an engine was registered with (letters, digits and
underscores). If it's empty, the generic prefix "re" is used.
.IP \(bu 2
\fBdelimiter\fR is any printable ASCII character that isn't alphanumeric,
whitespace, \fB_\fR, \fB\e\fR or the engine's escape character. The opening
brackets \fB(\fR, \fB[\fR, \fB{\fR and \fB<\fR are closed by their counterparts.
.IP \(bu 2
\fBbody\fR is handed to the engine verbatim. To include the closing
delimiter in it, prefix it with the engine's escape character (\fB\e\fR for
most engines, \fB%\fR for Lua). The escape sequence is NOT removed, so
engines must accept an escaped punctuation character as a literal.
.IP \(bu 2
\fBflags\fR is whatever follows the closing delimiter. Its meaning is
defined by the engine, but single letters are the convention (\fBi\fR, \fBm\fR,
\fBs\fR, \fBx\fR, \fBu\fR, ...). Unknown flags should be rejected by the engine.
.PP
The generic prefix "re" is bound to the first registered engine that is
marked as \fBPSTREXPR_REGEX\fR. It can be rebound using \fBpstrexpr_alias\fR.
.SS CAPTURES
.PP
Operations that report captures fill a \fBpstrarray_t\fR. Item \fB0\fR is the
whole match, items \fB1..n\fR are capture groups. Items are slices of the
searched string, so they don't need to be freed individually and are only
valid while that string is alive and unmoved (watch out for SSO strings).
The array itself may be freed with \fBpstrarray_free\fR.
.PP
A group that didn't take part in the match is a zeroed \fBpstring_t\fR, which
can be told apart from an empty match using \fBpstrexpr_isset\fR.
.PP
The array may be a zeroed \fBpstrarray_t\fR (it is allocated on demand, using
its allocator or the standard one), or an array with a user supplied
buffer, in which case \fBPSTRING_ERANGE\fR is returned if it's too small.
Old items are discarded without being freed.
.SS EMPTY MATCHES
.PP
Operations that find all matches (\fBiter\fR, \fBsplit\fR, \fBrepl\fR) continue after
an empty match by skipping one character (a whole UTF\-8 sequence if the
engine reports \fBPSTREXPR_UTF8\fR). A non\-empty match may follow an empty
one at the next position, as in Python 3.7+ and JavaScript.
.SS THREAD SAFETY
.PP
The registry and the pattern cache are protected by a mutex, and compiled
patterns are reference counted, so all functions can be called from
multiple threads. A compiled \fBpstrexpr_t\fR may be shared between threads
provided the engine's \fBexec\fR is reentrant, which holds for all bundled
adapters.
.PP
Locking and counting are built on \fBpf_threads.h\fR and \fBpf_atomic.h\fR, which
use C11 \fB<threads.h>\fR and \fB<stdatomic.h>\fR where available and fall back to
POSIX or Windows threads and GNU C builtins otherwise. Without any atomics
the counts are guarded by the same mutex. Define \fBPSTREXPR_SINGLE_THREADED\fR
(or \fBPF_NO_PTHREAD\fR, for POSIX) to drop all locking.
.SH REFERENCE
.SS PSTREXPR_CACHE_SIZE
.PP
Number of compiled patterns kept by the cached variants (LRU eviction).
.SS PSTREXPR_NOSPAN
.PP
Value of \fBstart\fR and \fBend\fR of an unset (non\-participating) group.
.SS pstrexpr_flag
.PP
Engine properties, set in \fBpstrexpr_vt.flags\fR.
.SS pstrexpr_prop
.PP
Properties of a compiled pattern, set by \fBpstrexpr_vt.compile\fR.
.SS pstrexpr_span_t
.PP
Byte range \fB[start, end)\fR inside the searched string.
.SS pstrexpr_info
.PP
Information about a pattern, reported by \fBpstrexpr_vt.compile\fR.
.SS pstriterp_fn
.PP
Callback for \fBpstriterp\fR and \fBpstrexpr_iter\fR. \fBgroups\fR holds the captures
of the match number \fBindex\fR (see CAPTURES). The array and its items are
only valid during the call.
.PP
Returns \fB0\fR to continue, a positive value to stop iterating, or
a negative \fBpstring_error\fR to abort with that error.
.SS pstrexpr_vt
.PP
Pattern matching engine vtable.
.PP
The vtable and \fBuser\fR must outlive every pattern compiled with them
(static storage is the usual choice). Strings handed to the callbacks
are not null\-terminated; use \fBpstrterm\fR if you need that.
All callbacks should return \fBPSTRING_*\fR error codes.
.SS pstrexpr_register
.PP
Registers an engine under the name \fBprefix\fR. If the engine is marked
\fBPSTREXPR_REGEX\fR and the prefix "re" is not taken, "re" will refer to it.
.PP
The same prefix can't be registered twice, except for "re" when it's only
an alias. Registration is meant to happen during initialization.
.PP
\fBErrors\fR
.PP
EINVAL, EEXIST, ENOMEM.
.SS pstrexpr_alias
.PP
Makes \fBalias\fR an alternative name of the engine registered as \fBprefix\fR,
replacing a previous alias with that name. This can be used to select
which engine the generic prefix "re" refers to.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT, EEXIST (\fBalias\fR is a real engine), ENOMEM.
.SS pstrexpr_cache_clear
.PP
Drops all patterns held by the cache of \fBpstrmatch\fR and friends.
.SS pstrexpr_isset
.PP
Checks if the capture \fBgroup\fR took part in the match.
.SS pstrmatch
.PP
Searches \fBsrc\fR for the first match of \fBpattern\fR. If \fBcaptures\fR is not
\fBNULL\fR, it receives the groups (see CAPTURES), or is emptied if there
is no match.
.PP
Returns \fBPSTRING_TRUE\fR, \fBPSTRING_FALSE\fR or a negative error:
EINVAL (malformed pattern or arguments), ENOENT (unknown engine),
ENOMEM, ERANGE, and any error reported by the engine.
.SS pstrsplitp
.PP
Splits \fBsrc\fR on every match of \fBpattern\fR, storing the pieces (slices of
\fBsrc\fR) in \fBparts\fR. At most \fBmaxSplit\fR splits are done (\fB0\fR means no
limit), so there are at most \fBmaxSplit + 1\fR pieces. Capture groups are
not included. Empty matches at the very start or end are ignored.
.PP
Returns the number of pieces (at least one) or a negative error.
.SS pstrreplp
.PP
Replaces at most \fBmax\fR matches of \fBpattern\fR in \fBstr\fR with \fBrepl\fR
(\fB0\fR means all of them). The string must be owned (not a slice) and is
left untouched on failure.
.PP
The replacement may contain references to groups: \fB$0\fR (whole match) to
\fB$9\fR, \fB${12}\fR, \fB${name}\fR (if the engine supports it) and \fB$$\fR for a
literal \fB$\fR. Groups that didn't take part in the match are empty.
.PP
Returns the number of replacements or a negative error.
.SS pstriterp
.PP
Calls \fBiter\fR for every match of \fBpattern\fR in \fBsrc\fR, until it asks
to stop. Returns the number of matches visited or a negative error.
.SS pstrexpr_compile
.PP
Compiles \fBpattern\fR and stores it in \fBout\fR, which must be released with
\fBpstrexpr_free\fR. If \fBalloc\fR is \fBNULL\fR, the standard allocator is used.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT, ENOMEM, and any error reported by the engine.
.SS pstrexpr_free
.PP
Releases a pattern created by \fBpstrexpr_compile\fR.
.SS pstrexpr_groups
.PP
Returns the number of capture groups, not counting the whole match.
.SS pstrexpr_match
.PP
Variants of \fBpstrmatch\fR, \fBpstrsplitp\fR, \fBpstrreplp\fR and \fBpstriterp\fR which
take a precompiled pattern.
.SS pstrexpr_escape
.PP
Appends \fBtext\fR to \fBout\fR, escaped so that the engine registered as
\fBprefix\fR (the generic one if \fBNULL\fR or empty) matches it literally. The
result is the body of a pattern: the delimiters and flags are not added.
.PP
Unless the engine has its own \fBquote\fR callback, every ASCII punctuation or
whitespace character is preceded by the engine's escape character, which
also protects the delimiter whatever it is. Engines with their own
callback only escape what they must, so the body is only safe inside a
delimiter that doesn't occur in it. Prefer \fBpstrexpr_quote\fR for building
patterns from untrusted text.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT, ENOMEM.
.SS pstrexpr_quote
.PP
Appends a complete pattern to \fBout\fR that matches \fBtext\fR literally,
including the prefix, a delimiter which is guaranteed not to occur in the
body, and the given \fBflags\fR (optional). The result is safe to use with the
functions above, no matter what \fBtext\fR contains:
.PP
.RS 4
.nf
pstring_t pat = { 0 };
pstrexpr_quote(&pat, "pcre", user_input, "i");
pstrmatch(pstrbuf(&pat), haystack, NULL);
pstrfree(&pat);
.fi
.RE
.PP
On failure \fBout\fR is left as it was.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT, ENOMEM, ERANGE (no usable delimiter).
